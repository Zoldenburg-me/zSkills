#!/usr/bin/env python3
"""Manage extra agent-tracker boards for Claude Code, Codex CLI and OpenCode.

  board add <name> <url> [--tool claude|codex|opencode] [--token-file PATH]
      register MCP server agent-tracker-<name> with that tool (default claude)
  board token <name>
      ask for the token (hidden input), write it to the token file (mode 600), check it
  board list [--tool ...]          the boards registered with that tool
  board remove <name> [--tool ...] unregister agent-tracker-<name>

--tool claude without --token-file asks for the token here and puts it in Claude Code's
config, as before. With --token-file, and always for codex and opencode, the config only
points at the token file (default ~/.config/agent-tracker/<name>.token) and the server reads
it at start; run `board token <name>` yourself in a terminal to write it, so the token never
goes through a chat or a config file.

Codex: [mcp_servers.agent-tracker-<name>] in ~/.codex/config.toml ($CODEX_HOME).
OpenCode: mcp.agent-tracker-<name> in ~/.config/opencode/opencode.json.
Other entries in those files are kept. Tools show up as agent-tracker-<name>'s tracker_*.

The primary Claude Code board comes from the plugin's Board URL and token. The server code
is copied to ~/.config/agent-tracker/server so it survives plugin updates; run `board add`
again after updating the plugin to refresh it.
"""
import argparse
import getpass
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

CONF = os.path.abspath(os.path.expanduser(os.environ.get("AGENT_TRACKER_HOME", "~/.config/agent-tracker")))
SRC = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "server")
DEST = os.path.join(CONF, "server")
LAUNCH = os.path.join(DEST, "launch.py")
CODEX = os.path.join(os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex")), "config.toml")
OPENCODE = os.path.join(os.path.expanduser(os.environ.get("XDG_CONFIG_HOME", "~/.config")), "opencode", "opencode.json")
TOOLS = ("claude", "codex", "opencode")


def claude(*args):
    try:
        return subprocess.run(["claude", "mcp", *args], capture_output=True, text=True)
    except OSError as e:
        sys.exit(f"Can't run claude: {e}")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None  # a redirect would carry the Authorization header to the new host


def whoami(url, token):
    req = urllib.request.Request(url + "/api/whoami", headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.build_opener(NoRedirect).open(req, timeout=15) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except (OSError, ValueError) as e:
        sys.exit(f"Can't reach {url}: {e}")


def url_ok(url):
    """https anywhere; plain http only to this machine, since the token goes in the header."""
    u = urllib.parse.urlsplit(url)
    return u.scheme == "https" or (u.scheme == "http" and u.hostname in ("localhost", "127.0.0.1", "::1"))


def check_name(name):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", name):
        sys.exit("Name: lowercase letters, digits and dashes, up to 31 characters.")


def board_file(name):
    return os.path.join(CONF, f"{name}.board.json")


TOML_HEADER = re.compile(r"^\s*\[\[?\s*([^\]]+?)\s*\]\]?\s*(#.*)?$")


def toml_set(text, server, block):
    """Drop the [mcp_servers.<server>] table (and its subtables) from text, then append block
    unless it is None. Returns (new text, whether the table was there). Every other line stays.
    shortcut: line-based, so a table header written inside a multi-line string would confuse it;
    the result is re-parsed with tomllib where Python has it (3.11+)."""
    ours = re.compile(r'mcp_servers\s*\.\s*"?%s"?(\s*\..*)?' % re.escape(server))
    out, skip, found = [], False, False
    for line in text.splitlines(keepends=True):
        m = TOML_HEADER.match(line)
        if m:
            skip = bool(ours.fullmatch(m.group(1)))
            found = found or skip
        if not skip:
            out.append(line)
    new = "".join(out)
    if block:
        new = new.rstrip("\n") + ("\n\n" if new.strip() else "") + block
    try:
        import tomllib
    except ImportError:
        return new, found
    try:
        tomllib.loads(new)
    except tomllib.TOMLDecodeError as e:
        raise ValueError(f"the result would not be valid TOML ({e})")
    return new, found


def codex_block(server, env):
    envs = ", ".join(f"{k} = {json.dumps(v)}" for k, v in env.items())  # JSON strings are valid TOML strings
    return f'[mcp_servers.{server}]\ncommand = "python3"\nargs = [{json.dumps(LAUNCH)}]\nenv = {{ {envs} }}\n'


def json_set(text, server, entry):
    """Same as toml_set for opencode.json's "mcp" object; entry None removes it."""
    cfg = json.loads(text) if text.strip() else {}
    if not isinstance(cfg, dict) or not isinstance(cfg.setdefault("mcp", {}), dict):
        raise ValueError('expected a JSON object with an "mcp" object')
    found = cfg["mcp"].pop(server, None) is not None
    if entry:
        cfg["mcp"][server] = entry
    return json.dumps(cfg, indent=2) + "\n", found


def write_private(path, text, keep_mode=True):
    """Write via a temp file and rename. New files get mode 600; keep_mode keeps an existing file's mode."""
    path = os.path.realpath(path)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    mode = 0o600
    if keep_mode:
        try:
            mode = os.stat(path).st_mode & 0o777
        except FileNotFoundError:
            pass
    tmp = path + ".board-tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    os.fchmod(fd, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def edit(tool, server, env):
    """Set (env) or remove (env None) the server in the codex or opencode config."""
    path = CODEX if tool == "codex" else OPENCODE
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    try:
        if tool == "codex":
            new, found = toml_set(text, server, env and codex_block(server, env))
        else:
            new, found = json_set(text, server, env and {"type": "local", "command": ["python3", LAUNCH], "environment": env})
    except ValueError as e:
        sys.exit(f"Can't update {path}: {e}. Nothing changed.")
    if env or found:
        write_private(path, new)
    return path, found


def ask_token(url):
    for _ in range(3):
        token = getpass.getpass(f"Token for {url} (input hidden): ").strip()
        code = whoami(url, token) if token else "empty"
        if code == 200:
            return token
        print(f"That didn't work (HTTP {code}).")
    sys.exit("No working token; nothing changed.")


def add(name, url, tool, token_file):
    check_name(name)
    url = url.strip().rstrip("/")
    if not url_ok(url):
        sys.exit("The board URL must start with https:// (or http://localhost, 127.0.0.1 or [::1] for a local board).")
    server = f"agent-tracker-{name}"
    env = {"AGENT_DASH_URL": url, "AGENT_TRACKER_NAMES": os.path.join(CONF, f"names-{name}.json")}
    if tool == "claude" and not token_file:
        env["AGENT_DASH_TOKEN"] = ask_token(url)  # shortcut: claude mcp add takes it in argv, so ps can see it briefly
    else:
        token_file = os.path.abspath(os.path.expanduser(token_file or os.path.join(CONF, f"{name}.token")))
        env["AGENT_DASH_TOKEN_FILE"] = token_file
    try:
        shutil.copytree(SRC, DEST, dirs_exist_ok=True)
        write_private(board_file(name), json.dumps({"url": url, "token_file": token_file or os.path.join(CONF, f"{name}.token")}) + "\n")
        if tool == "claude":
            cmd = ["add", server, "--scope", "user", *[a for k, v in env.items() for a in ("-e", f"{k}={v}")],
                   "--", "python3", LAUNCH]
            out = claude(*cmd)
            if out.returncode and claude("get", server).returncode == 0:  # already there: replace it
                if claude("remove", server, "-s", "user").returncode == 0:
                    out = claude(*cmd)
            if out.returncode:
                sys.exit(out.stderr.strip() or "claude mcp add failed")
            where = "Claude Code"
        else:
            where, _ = edit(tool, server, env)
    except OSError as e:
        sys.exit(f"Can't set up {server}: {e}")
    print(f"Added {server} to {where}. New sessions get its tracker_* tools.")
    if token_file and not os.path.exists(token_file):
        print(f"No token yet. Run this yourself in a terminal: board token {name}")


def token(name):
    check_name(name)
    try:
        with open(board_file(name)) as f:
            board = json.load(f)
    except (OSError, ValueError):
        sys.exit(f"No board {name} here; run `board add {name} <url>` first.")
    secret = getpass.getpass(f"Token for {board['url']} (input hidden): ").strip()
    if not secret:
        sys.exit("No token entered; nothing changed.")
    try:
        write_private(board["token_file"], secret + "\n", keep_mode=False)
    except OSError as e:
        sys.exit(f"Can't write {board['token_file']}: {e}")
    code = whoami(board["url"], secret)
    if code != 200:
        sys.exit(f"Saved to {board['token_file']}, but {board['url']} rejected it (HTTP {code}). Run `board token {name}` again.")
    print(f"OK: token saved to {board['token_file']} and accepted by {board['url']}.")


def list_boards(tool):
    if tool == "claude":
        out = claude("list")
        if out.returncode:
            sys.exit(out.stderr.strip() or "claude mcp list failed")
        names = [l for l in out.stdout.splitlines() if l.startswith("agent-tracker")]
    else:
        path = CODEX if tool == "codex" else OPENCODE
        try:
            with open(path) as f:
                text = f.read()
            if tool == "codex":
                names = sorted({m.group(1) for m in re.finditer(r'(?m)^\s*\[\s*mcp_servers\s*\.\s*"?(agent-tracker[a-z0-9-]*)', text)})
            else:
                names = sorted(k for k in json.loads(text or "{}").get("mcp", {}) if k.startswith("agent-tracker"))
        except FileNotFoundError:
            names = []
        except (OSError, ValueError, AttributeError) as e:
            sys.exit(f"Can't read {path}: {e}")
    print("\n".join(names) or f"No agent-tracker boards registered with {tool}.")


def remove(name, tool):
    check_name(name)
    server = f"agent-tracker-{name}"
    if tool == "claude":
        out = claude("remove", server, "-s", "user")
        print(out.stdout.strip() or out.stderr.strip())
        if out.returncode:
            sys.exit(1)
        return
    try:
        path, found = edit(tool, server, None)
    except OSError as e:
        sys.exit(f"Can't update the {tool} config: {e}")
    if not found:
        sys.exit(f"No {server} in {path}.")
    print(f"Removed {server} from {path}.")


def main(argv):
    p = argparse.ArgumentParser(prog="board", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add")
    a.add_argument("name")
    a.add_argument("url")
    a.add_argument("--token-file")
    sub.add_parser("token").add_argument("name")
    ls = sub.add_parser("list")
    rm = sub.add_parser("remove")
    rm.add_argument("name")
    for s in (a, ls, rm):
        s.add_argument("--tool", choices=TOOLS, default="claude")
    args = p.parse_args(argv)
    if args.cmd == "add":
        add(args.name, args.url, args.tool, args.token_file)
    elif args.cmd == "token":
        token(args.name)
    elif args.cmd == "list":
        list_boards(args.tool)
    else:
        remove(args.name, args.tool)


if __name__ == "__main__":
    main(sys.argv[1:])
