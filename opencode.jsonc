{
  "$schema": "https://opencode.ai/config.json",
  // Same servers as ai-harness/.mcp.json, in OpenCode's format.
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@4.4.2"],
      "enabled": true
    },
    // TypeSafe scoring for skill-router and repo-leak-scan. Needs
    // TYPESAFE_API_KEY and sends task text to TypeSafe; enable it when you use them.
    "system1": {
      "type": "local",
      "command": ["uvx", "system1-mcp==0.2.1"],
      "enabled": false
    }
  }
}
